---
// Pillar 1: every tip names its source. Typographic, not cards: the
// acronyms carry the section, each with its Georgian name and the one
// part of the app it backs (§A7 roster, D5 order). No logos (trademarks).
import Icon from './Icon.astro';
import Title from './Title.astro';
import { sources, sourcesDisclaimer } from '../data/sources';
---

<section class="band-b section" id="sources" aria-labelledby="sources-title">
  <div class="wrap">
    <div class="head reveal">
      <Title id="sources-title" text="ყოველი რჩევა [სანდო] წყაროებიდან." />
      <p class="lead">
        პრობლემა ინფორმაციის ნაკლებობა არ არის. პრობლემა ისაა, რომ ვერ არჩევ, ვის ენდო. ჩვენს აპლიკაციაში ყველა რჩევას თან ახლავს ინფორმაციის წყარო, რათა თავად შეძლოთ მისი გადამოწმება.
      </p>
    </div>

    <ul class="list">
      {sources.map((s, i) => (
        <li class="reveal" style={`--i: ${i}`}>
          <a href={s.url} target="_blank" rel="noopener">
            <span class="acronym">
              {s.acronym}
              <Icon name="arrow-up-right" size={18} class="ext" />
            </span>
            <span class="name">{s.name}</span>
            <span class="domain">{s.domain}</span>
          </a>
        </li>
      ))}
    </ul>

    <p class="disclaimer reveal">
      <Icon name="info" size={18} />
      <span>{sourcesDisclaimer}</span>
    </p>
  </div>
</section>

<style>
  .head .lead { margin-top: 18px; }

  .list {
    list-style: none;
    margin: clamp(48px, 6vw, 72px) 0 0;
    padding: 28px 0 0;
    border-top: 1px solid var(--divider);
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 32px 28px;
  }

  a { display: flex; flex-direction: column; gap: 8px; }
  .acronym {
    display: inline-flex;
    align-items: flex-start;
    gap: 6px;
    font-size: clamp(1.75rem, 2.6vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .acronym :global(.ext) { opacity: 0; transform: translate(-4px, 4px); transition: opacity .2s ease, transform .25s var(--ease-out); color: var(--highlight-ink); }
  a:hover .acronym :global(.ext),
  a:focus-visible .acronym :global(.ext) { opacity: 1; transform: none; }

  .name { font-size: 0.875rem; color: var(--text-2); line-height: 1.5; }
  .domain { font-size: 0.875rem; font-weight: 700; color: var(--highlight-ink); line-height: 1.45; }

  /* small print at the section's bottom-left: the section gives up most of
     its bottom padding and the gap moves above the note */
  #sources { padding-bottom: clamp(28px, 3vw, 40px); }
  .disclaimer {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    width: fit-content;
    margin-top: clamp(64px, 8vw, 112px);
    font-size: 0.75rem;
    line-height: 1.55;
    color: var(--text-2);
  }
  .disclaimer :global(.icon) { margin-top: 1px; width: 15px; height: 15px; color: var(--text-2); }

  @media (max-width: 1000px) {
    .list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 20px; }
  }
</style>
