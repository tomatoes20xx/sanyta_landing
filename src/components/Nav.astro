---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import StoreButton from './StoreButton.astro';
import { nav, site } from '../data/site';

const path = Astro.url.pathname.replace(/(index)?\.html$/, '').replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href.replace(/\.html$/, '') || '/') === path;
---

<!-- Sits at the very top; when it scrolls out of view the nav turns solid. -->
<div class="nav-sentinel" aria-hidden="true"></div>
<header class="nav" data-nav>
  <div class="wrap nav-inner">
    <a class="brand" href="/" aria-label={`${site.name} — მთავარი`}>
      <img src="/brand/icon.png" alt="" width="36" height="36" />
      <span>{site.name}</span>
    </a>

    <nav class="links" aria-label="მთავარი მენიუ">
      {nav.map((l) => (
        <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>

    <div class="actions">
      <ThemeToggle />
      <StoreButton variant="outline" class="nav-cta" />
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="მენიუ">
        <span class="open"><Icon name="list" size={24} /></span>
        <span class="close"><Icon name="x" size={24} /></span>
      </button>
    </div>
  </div>

  <nav class="mobile" id="mobile-menu" aria-label="მენიუ" hidden>
    {nav.map((l) => <a href={l.href}>{l.label}</a>)}
    <StoreButton class="menu-cta" />
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-nav]');
  const sentinel = document.querySelector('.nav-sentinel');
  if (header) {
    if (sentinel && 'IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => header.classList.toggle('scrolled', !e.isIntersecting)).observe(sentinel);
    }

    const btn = header.querySelector<HTMLButtonElement>('.menu-btn');
    const menu = header.querySelector<HTMLElement>('#mobile-menu');
    const setOpen = (open: boolean) => {
      btn?.setAttribute('aria-expanded', String(open));
      if (menu) menu.hidden = !open;
      header.classList.toggle('open', open);
    };
    btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    menu?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }
</script>

<style>
  .nav-sentinel { position: absolute; top: 0; left: 0; width: 1px; height: 8px; }

  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-nav);
    color: var(--text);
    transition: background-color .3s ease, box-shadow .3s ease;
  }
  .nav.scrolled,
  .nav.open {
    background: var(--nav-bg);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    box-shadow: 0 1px 0 var(--divider);
  }
  @media (prefers-reduced-transparency: reduce) {
    .nav.scrolled, .nav.open { background: var(--band-a); backdrop-filter: none; -webkit-backdrop-filter: none; }
  }

  .nav-inner {
    height: var(--nav-h);
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
  }
  .brand img { width: 36px; height: 36px; border-radius: 10px; }

  .links {
    flex: 1;
    display: flex;
    justify-content: center;
    gap: 32px;
  }
  .links a {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--text-2);
    transition: color .15s ease;
  }
  .links a:hover,
  .links a[aria-current='page'] { color: var(--text); }

  .actions { display: flex; align-items: center; gap: 12px; }
  .actions :global(.nav-cta) { min-height: 42px; padding: 8px 20px; font-size: 0.9375rem; }

  .menu-btn {
    display: none;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .menu-btn span { display: grid; place-items: center; }
  .menu-btn .close { display: none; }
  .menu-btn[aria-expanded='true'] .open { display: none; }
  .menu-btn[aria-expanded='true'] .close { display: grid; }

  .mobile {
    display: flex;
    flex-direction: column;
    padding: 8px var(--gutter) 20px;
  }
  .mobile[hidden] { display: none; }
  .mobile a:not(.pill) {
    padding: 14px 0;
    font-weight: 600;
    border-bottom: 1px solid var(--divider);
  }
  .mobile :global(.menu-cta) { margin-top: 18px; align-self: flex-start; }

  @media (max-width: 820px) {
    .links { display: none; }
    .brand { margin-right: auto; }
    .menu-btn { display: grid; }
  }
  @media (max-width: 480px) {
    /* the hero's own button is right below, and the menu carries one */
    .actions :global(.nav-cta) { display: none; }
    .actions { gap: 4px; }
  }
  @media (min-width: 821px) {
    .mobile { display: none !important; }
  }
</style>
