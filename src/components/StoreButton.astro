---
// The site's only call to action: download from the App Store.
// One label everywhere ("ჩამოტვირთე"), App Store only, never Google Play (§A2).
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  variant?: 'solid' | 'outline';
  class?: string;
}

const { variant = 'solid', class: extra = '' } = Astro.props;
---

<a
  class:list={['pill', variant === 'solid' ? 'pill-solid' : 'pill-outline', extra]}
  href={site.appStoreUrl}
  target="_blank"
  rel="noopener"
>
  <Icon name="apple-logo" weight="fill" size={20} />
  <span>ჩამოტვირთე</span>
  <span class="sr-only">(App Store, გაიხსნება ახალ ფანჯარაში)</span>
</a>
