---
// One feature, one section: copy on one side, the real app screen (or two,
// overlapped) on the other. Sections alternate sides and page tones so the
// run of features doesn't read as a repeated block.
import FirstAidCard from './FirstAidCard.astro';
import Icon from './Icon.astro';
import PhoneMockup from './PhoneMockup.astro';
import Title from './Title.astro';
import type { FeatureSection, Shot } from '../data/features';

interface Props {
  feature: FeatureSection;
  band: 'a' | 'b';
  reverse?: boolean;
  /** straight under a PageHero: drop the top padding the hero already gives */
  flush?: boolean;
}

const { feature: f, band, reverse = false, flush = false } = Astro.props;
const titleId = `${f.id}-title`;
const screens = f.screens ?? [];
// a partner's site opens in a new tab; our own feature pages don't
const external = f.link ? /^https?:/.test(f.link.href) : false;
// sections whose phones move get played by src/scripts/media.ts
const moves = screens.some((s: Shot) => s.clip || s.overlay);
---

<section class:list={[`band-${band}`, 'section', { reverse, flush }]} id={f.id} aria-labelledby={titleId}>
  <div class="wrap grid">
    <div class="text reveal">
      <Title id={titleId} text={f.title} kicker={f.name} />
      {f.body.map((p) => <p class="lead">{p}</p>)}
      {f.link && (
        <a
          class="link-arrow more"
          href={f.link.href}
          {...(external ? { target: '_blank', rel: 'noopener' } : {})}
        >
          {f.link.label} <Icon name={external ? 'arrow-up-right' : 'arrow-right'} size={18} />
        </a>
      )}
    </div>

    <div
      class:list={['visual', 'reveal', { pair: screens.length === 2, card: f.card }]}
      style="--i: 1"
      data-media-group={moves ? '' : undefined}
    >
      {screens.length === 1 && (
        <PhoneMockup screen={screens[0].screen} clip={screens[0].clip} overlay={screens[0].overlay} alt={screens[0].alt} />
      )}
      {/* the front phone (the first screen) plays first */}
      {screens.length === 2 && (
        <>
          <PhoneMockup screen={screens[1].screen} clip={screens[1].clip} alt={screens[1].alt} class="back" order={2} />
          <PhoneMockup screen={screens[0].screen} clip={screens[0].clip} alt={screens[0].alt} class="front" order={1} />
        </>
      )}
      {f.card === 'first-aid' && <FirstAidCard />}
    </div>
  </div>
</section>

<script>
  import '../scripts/media';
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }
  .reverse .grid { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); }
  .section.flush { padding-top: 8px; }
  .reverse .text { order: 2; }

  /* the feature name, inside the h2 (Title's kicker) but set as body text */
  .text :global(.kicker) {
    display: block;
    width: max-content;
    max-width: 100%;
    margin-bottom: 12px;
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.65;
    letter-spacing: normal;
    color: var(--highlight-ink);
  }
  .text :global(h2) { max-width: 16ch; }
  .text .lead { margin-top: 20px; max-width: 44ch; }
  .text .lead + .lead { margin-top: 12px; }
  .more { margin-top: 24px; }

  .visual { display: flex; justify-content: center; }
  .visual :global(.phone) { --phone-w: clamp(240px, 23vw, 300px); }

  /* two screens, overlapped and offset. The pair is sized from the phone
     width and centred, so the overlap holds however wide the column gets. */
  .visual.pair {
    --pair-phone: clamp(190px, 20vw, 260px);
    position: relative;
    justify-self: center;
    width: min(100%, calc(var(--pair-phone) * 1.9));
    height: calc(var(--pair-phone) * 2.3);
  }
  .visual.pair :global(.phone) { position: absolute; --phone-w: var(--pair-phone); }
  .visual.pair :global(.back) { right: 0; top: 0; }
  .visual.pair :global(.front) { left: 0; bottom: 0; }
  .reverse .visual.pair :global(.back) { right: auto; left: 0; }
  .reverse .visual.pair :global(.front) { left: auto; right: 0; }

  /* the phone that plays comes to the front (src/scripts/media.ts sets
     data-front); without the script the DOM order keeps .front on top */
  .visual.pair :global(.phone) { z-index: 1; }
  .visual.pair :global(.phone[data-front]) { z-index: 2; }

  /* pause / replay sit on each phone's outer edge, where the other phone
     never covers them, whichever is in front */
  .visual.pair :global(.front .media-btn),
  .reverse .visual.pair :global(.back .media-btn) { right: auto; left: 12px; }
  .reverse .visual.pair :global(.front .media-btn) { left: auto; right: 12px; }

  @media (max-width: 860px) {
    .reverse .visual.pair :global(.back .media-btn) { left: auto; right: 12px; }
    .reverse .visual.pair :global(.front .media-btn) { right: auto; left: 12px; }
    .grid,
    .reverse .grid { grid-template-columns: 1fr; }
    .reverse .text { order: 0; }
    .visual :global(.phone) { --phone-w: clamp(200px, 58vw, 260px); }
    .visual.pair { --pair-phone: clamp(160px, 46vw, 230px); height: calc(var(--pair-phone) * 2.4); }
    .visual.pair :global(.back),
    .reverse .visual.pair :global(.back) { right: 0; left: auto; }
    .visual.pair :global(.front),
    .reverse .visual.pair :global(.front) { left: 0; right: auto; }
  }
</style>
